APP_NAME="Tocaan Order & Payment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tocaan_order_payment
DB_USERNAME=tocaan_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
FORWARD_DB_PORT=33060

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Atomic Locks (Redis)
CACHE_STORE=redis
CACHE_PREFIX=tocaan_cache_
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=63790

# Queue Configuration (RabbitMQ - vladimir-yuldashev/laravel-queue-rabbitmq)
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
FORWARD_RABBITMQ_PORT=5672
FORWARD_RABBITMQ_MGMT_PORT=15672

# JWT Authentication Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Payment Gateways Configuration (Strategy Pattern)
PAYMENT_DEFAULT_GATEWAY=credit_card

# Credit Card Gateway Settings
CREDIT_CARD_ENABLED=true
CREDIT_CARD_API_KEY=cc_live_sim_key_123456
CREDIT_CARD_API_SECRET=cc_live_sim_secret_abcdef
CREDIT_CARD_WEBHOOK_SECRET=whsec_credit_card_secret_key_999
CREDIT_CARD_ENDPOINT=https://api.simulated-cc-gateway.local/v1/charges

# PayPal Gateway Settings
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=paypal_sim_client_id_7890
PAYPAL_CLIENT_SECRET=paypal_sim_client_secret_xyz
PAYPAL_WEBHOOK_SECRET=whsec_paypal_secret_key_888
PAYPAL_MODE=sandbox
PAYPAL_ENDPOINT=https://api-m.sandbox.paypal.com

# Idempotency Configuration
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=10
