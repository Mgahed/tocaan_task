    {
      "name": "3. Payments Management (Strategy Pattern)",
      "description": "Endpoints for processing payments via pluggable gateway strategies (`credit_card`, `paypal`, etc.) and viewing payment history. Automatically saves `transaction_id` and `payment_id` for Webhook testing.",
      "item": [
        {
          "name": "Process Payment - Credit Card (Pending 3DS for Webhook Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.transaction_id) {",
                  "        pm.collectionVariables.set('transaction_id', jsonData.data.transaction_id);",
                  "    }",
                  "    if (jsonData.data.payment_id) {",
                  "        pm.collectionVariables.set('payment_id', jsonData.data.payment_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payment_method\": \"credit_card\",\n    \"payment_details\": {\n        \"card_number\": \"4242424242421111\",\n        \"expiry_month\": 12,\n        \"expiry_year\": 2029,\n        \"cvv\": \"123\"\n    },\n    \"simulate_pending\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}",
                "payments"
              ]
            },
            "description": "Creates a `pending` payment on a confirmed order and saves its `transaction_id` and `payment_id` in collection variables so you can immediately trigger a Webhook to transition it to `successful` or `failed`."
          },
          "response": []
        },
        {
          "name": "Process Payment - Credit Card (Immediate Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.transaction_id) {",
                  "        pm.collectionVariables.set('transaction_id', jsonData.data.transaction_id);",
                  "    }",
                  "    if (jsonData.data.payment_id) {",
                  "        pm.collectionVariables.set('payment_id', jsonData.data.payment_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Guarantees exactly-once payment processing"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payment_method\": \"credit_card\",\n    \"payment_details\": {\n        \"card_number\": \"4242424242424242\",\n        \"expiry_month\": 12,\n        \"expiry_year\": 2029,\n        \"cvv\": \"123\"\n    },\n    \"simulate_pending\": false,\n    \"simulate_failure\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}",
                "payments"
              ]
            }
          },
          "response": [
            {
              "name": "201 Created - Payment Successful",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n    \"success\": true,\n    \"message\": \"Payment processed successfully.\",\n    \"data\": {\n        \"id\": 1,\n        \"payment_id\": \"d290f1ee-6c54-4b01-90e6-d701748f0851\",\n        \"order_id\": 2,\n        \"payment_method\": \"credit_card\",\n        \"status\": \"successful\",\n        \"amount\": 499.99,\n        \"transaction_id\": \"cc_txn_9f8e7d6c5b4a3210abcd\",\n        \"gateway_response\": {\n            \"gateway\": \"credit_card\",\n            \"card_last4\": \"4242\",\n            \"currency\": \"USD\",\n            \"amount\": 499.99,\n            \"authorization_code\": \"A8F92B1C\",\n            \"message\": \"Credit card charge approved.\"\n        }\n    }\n}"
            },
