    {
      "name": "4. Payment Webhooks (RabbitMQ Async - All Cases)",
      "description": "Public webhook endpoints secured via HMAC-SHA256 signature verification (`X-Webhook-Signature`).\n\nAll valid-signature requests use `pm.variables.replaceIn(pm.request.body.raw)` in their Pre-request Script so Postman resolves variables like `{{transaction_id}}` and `{{webhook_event_id}}` BEFORE computing the HMAC-SHA256 signature.",
      "item": [
        {
          "name": "4.1 Credit Card Webhook - Valid Signature (Mark Payment Successful)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a fresh event_id and save it so Case 4.2 can test duplicate replay",
                  "var eventId = 'evt_cc_' + Date.now();",
                  "pm.collectionVariables.set('webhook_event_id', eventId);",
                  "",
                  "var secret = pm.collectionVariables.get('cc_webhook_secret');",
                  "// Resolve all {{variables}} in body before computing HMAC-SHA256",
                  "var resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "var signature = CryptoJS.HmacSHA256(resolvedBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: signature });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event_id\": \"{{webhook_event_id}}\",\n    \"event_type\": \"charge.succeeded\",\n    \"transaction_id\": \"{{transaction_id}}\",\n    \"payment_id\": \"{{payment_id}}\",\n    \"status\": \"successful\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/payments/credit_card",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "payments",
                "credit_card"
              ]
            },
            "description": "Computes a valid HMAC-SHA256 signature over the resolved body, verifies it, records the webhook event, and dispatches `ProcessPaymentWebhookJob` to RabbitMQ (`payment_webhooks` queue) to mark the payment `successful`."
          },
          "response": [
            {
              "name": "200 OK - Webhook Verified and Queued",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n    \"success\": true,\n    \"message\": \"Webhook event verified and queued for processing.\",\n    \"data\": {\n        \"duplicate\": false,\n        \"event_id\": \"evt_cc_1761147000000\",\n        \"gateway\": \"credit_card\",\n        \"payment_id\": \"11111111-2222-3333-4444-555555555555\",\n        \"order_id\": 3,\n        \"target_status\": \"successful\",\n        \"status\": \"pending\"\n    }\n}"
            }
          ]
        },
        {
          "name": "4.2 Credit Card Webhook - Duplicate Replay (Idempotency Case)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
