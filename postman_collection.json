    {
      "name": "2. Orders & Products Management",
      "description": "Endpoints for listing catalog products and creating, viewing, filtering, updating, and deleting orders. Customer data is automatically taken from the authenticated JWT user, and product titles & prices are resolved directly from the database via `product_id`.",
      "item": [
        {
          "name": "List Available Products (Catalog)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Retrieves active products stored in the database along with their IDs and prices."
          },
          "response": [
            {
              "name": "200 OK - Products List",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n    \"success\": true,\n    \"message\": \"Products retrieved successfully.\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"name\": \"Wireless Mechanical Keyboard\",\n            \"description\": \"RGB Hot-swappable Wireless Mechanical Keyboard\",\n            \"price\": 125,\n            \"stock\": 50,\n            \"is_active\": true\n        },\n        {\n            \"id\": 2,\n            \"name\": \"27-inch 4K IPS Monitor\",\n            \"description\": \"Ultra HD 144Hz IPS Display Monitor\",\n            \"price\": 499.99,\n            \"stock\": 30,\n            \"is_active\": true\n        }\n    ]\n}"
            }
          ]
        },
        {
          "name": "Create Order (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Prevents duplicate order creation on network retries"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"shipping_address\": \"Kuwait City, Sharq, Block 2\",\n    \"notes\": \"Deliver during business hours\",\n    \"items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 2\n        },\n        {\n            \"product_id\": 2,\n            \"quantity\": 1\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Creates a new order for the authenticated JWT user. Resolves each item's `product_name` and `unit_price` from the `products` table by `product_id`, and calculates item subtotals and `total_amount` automatically."
          },
          "response": [
            {
              "name": "201 Created - Order Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n    \"success\": true,\n    \"message\": \"Order created successfully.\",\n    \"data\": {\n        \"id\": 5,\n        \"user_id\": 1,\n        \"status\": \"pending\",\n        \"total_amount\": 749.99,\n        \"shipping_address\": \"Kuwait City, Sharq, Block 2\",\n        \"notes\": \"Deliver during business hours\",\n        \"payments_count\": 0,\n        \"user\": {\n            \"id\": 1,\n            \"name\": \"Demo Customer\",\n            \"email\": \"test@example.com\",\n            \"created_at\": \"2026-10-22T12:00:00+00:00\"\n        },\n        \"items\": [\n            {\n                \"id\": 5,\n                \"product_id\": 1,\n                \"product_name\": \"Wireless Mechanical Keyboard\",\n                \"quantity\": 2,\n                \"unit_price\": 125,\n                \"subtotal\": 250\n            },\n            {\n                \"id\": 6,\n                \"product_id\": 2,\n                \"product_name\": \"27-inch 4K IPS Monitor\",\n                \"quantity\": 1,\n                \"unit_price\": 499.99,\n                \"subtotal\": 499.99\n            }\n        ],\n        \"payments\": [],\n        \"created_at\": \"2026-10-22T12:05:00+00:00\",\n        \"updated_at\": \"2026-10-22T12:05:00+00:00\"\n    }\n}"
            }
          ]
