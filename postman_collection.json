    {
      "name": "4. Payment Webhooks (RabbitMQ Async)",
      "description": "Public webhook endpoints secured via HMAC-SHA256 signature verification (`X-Webhook-Signature`). Includes Pre-request Script to compute the valid HMAC signature automatically.",
      "item": [
        {
          "name": "Credit Card Webhook Notification",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var secret = pm.collectionVariables.get('cc_webhook_secret');",
                  "var rawBody = pm.request.body.raw;",
                  "var signature = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: signature });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event_id\": \"evt_cc_90001\",\n    \"event_type\": \"charge.succeeded\",\n    \"transaction_id\": \"{{transaction_id}}\",\n    \"status\": \"successful\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/payments/credit_card",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "payments",
                "credit_card"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK - Webhook Verified and Queued",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n    \"success\": true,\n    \"message\": \"Webhook event verified and queued for processing.\",\n    \"data\": {\n        \"duplicate\": false,\n        \"event_id\": \"evt_cc_90001\",\n        \"gateway\": \"credit_card\",\n        \"status\": \"pending\"\n    }\n}"
