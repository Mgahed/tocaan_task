                  "        pm.collectionVariables.set('transaction_id', jsonData.data.transaction_id);",
                  "    }",
                  "    if (jsonData.data.payment_id) {",
                  "        pm.collectionVariables.set('payment_id', jsonData.data.payment_id);",
                  "    }",
                  "}"
