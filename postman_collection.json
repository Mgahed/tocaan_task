{
  "info": {
    "_postman_id": "9f8b2d10-4c7e-4b99-8d12-3f9a1c5e7788",
    "name": "Tocaan - Extendable Order & Payment Management API",
    "description": "Complete RESTful API collection for the Laravel 12 Extendable Order & Payment Management System.\n\nIncludes:\n- JWT Authentication (`register`, `login`, `me`, `refresh`, `logout`)\n- Order Management (`index` with status filter & pagination, `store` with Idempotency-Key, `show`, `update`, `destroy`)\n- Payment Management (`store` using Strategy Pattern for `credit_card` and `paypal`, `index`, `orderPayments`)\n- Asynchronous Payment Webhooks with automatic HMAC-SHA256 signature calculation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
